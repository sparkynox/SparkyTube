<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <LinearLayout
        android:id="@+id/logsTopBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_root"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/logsBackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Logs"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="4dp" />

        <ImageButton
            android:id="@+id/logsShareBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="Share logs"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/logsClearBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Clear logs"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Shown only when a crash report exists - tapped to jump straight
         to the crash section of the log below, since it's usually what
         the person actually came here to look for. -->
    <LinearLayout
        android:id="@+id/logsCrashBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_card"
        android:layout_margin="12dp"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/logsTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ Last crash found"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/logsCrashSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/logsCrashBanner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/logsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:typeface="monospace"
            android:textSize="11.5sp"
            android:textIsSelectable="true"
            android:textColor="@color/text_primary" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
