<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Gradient scrims (top + bottom) instead of one flat overlay across
         the whole frame — keeps the middle of the video visible/clear
         while controls stay readable at the edges, same idea as
         YouTube/most modern players. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_scrim_bottom" />

    <!-- Top row: video title (left) + quality gear (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp">

        <ImageButton
            android:id="@+id/exo_minimize_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@android:drawable/arrow_down_float"
            android:contentDescription="Minimize player" />

        <TextView
            android:id="@+id/exo_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="13.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="6dp" />

        <ImageButton
            android:id="@+id/exo_download_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@drawable/ic_download"
            android:contentDescription="Download video" />

        <ImageButton
            android:id="@+id/exo_audio_track_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@drawable/ic_audio_track"
            android:contentDescription="Audio track"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/exo_music_mode_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@drawable/ic_music_note"
            android:contentDescription="Audio-only mode" />

        <ImageButton
            android:id="@+id/exo_suggestions_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Up next / suggestions" />

        <ImageButton
            android:id="@+id/exo_quality_gear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@drawable/ic_quality"
            android:contentDescription="Quality settings" />
    </LinearLayout>

    <!-- Center transport controls: prev / play-pause / next, on glass
         circles, play/pause noticeably larger as the primary action -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/exo_prev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@drawable/ic_skip_previous"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/exo_play_pause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="18dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_player_btn_circle_primary"
            android:src="@drawable/ic_play"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/exo_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@drawable/ic_skip_next"
            android:contentDescription="Next" />
    </LinearLayout>

    <!-- Bottom row: elapsed time, seek bar, duration, fullscreen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="11.5sp" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:bar_height="3dp"
            app:touch_target_height="28dp"
            app:played_color="@color/accent"
            app:scrubber_color="@color/accent"
            app:scrubber_dragged_size="14dp"
            app:scrubber_enabled_size="10dp"
            app:unplayed_color="#4DFFFFFF"
            app:buffered_color="#80FFFFFF" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/exo_speed_btn"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:minWidth="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:background="@drawable/bg_player_btn_circle"
            android:text="1x"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-medium"
            android:contentDescription="Playback speed" />

        <ImageButton
            android:id="@+id/exo_fullscreen_toggle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_player_btn_circle"
            android:src="@drawable/ic_fullscreen"
            android:contentDescription="Fullscreen" />
    </LinearLayout>

    <!-- Buffering indicator -->
    <ProgressBar
        android:id="@+id/exo_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

</FrameLayout>
