<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <!-- Top bar: logo + search icon, fixed position, mimics official app header -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_root"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/logoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SparkyTube"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/audioTrackBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_audio_track"
            android:contentDescription="Audio track"
            android:visibility="gone"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/qualityBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_quality"
            android:contentDescription="Video quality"
            android:visibility="gone"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/searchBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Search"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Settings"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/overflowMenuBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="More options"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- WebView container -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_root"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/loadingSpinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <!-- v1.8 test: native (authenticated InnerTube) Home feed.
             Hidden by default; toggled from Settings > Native Home
             Feed. When shown, it sits on top of the WebView (which
             keeps running invisibly underneath, same "real session
             lives in the WebView" approach as the rest of the app);
             MainActivity swaps this vs the WebView's visibility rather
             than tearing either one down. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/nativeHomeFeedList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/exoPlayerView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="top"
            android:background="#000000"
            android:visibility="gone"
            app:use_controller="true"
            app:controller_layout_id="@layout/exo_player_controls"
            app:show_shuffle_button="false"
            app:show_next_button="false"
            app:show_previous_button="false"
            app:show_timeout="0"
            app:resize_mode="fit"
            app:surface_type="surface_view" />
    </FrameLayout>

    <!-- Fixed bottom nav — always same position, 4 tabs like official app -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="@drawable/nav_item_color" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textSize="10sp"
                android:textColor="@drawable/nav_item_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navShorts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shorts"
                app:tint="@drawable/nav_item_color" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_shorts"
                android:textSize="10sp"
                android:textColor="@drawable/nav_item_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSubs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_subscriptions"
                app:tint="@drawable/nav_item_color" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_subscriptions"
                android:textSize="10sp"
                android:textColor="@drawable/nav_item_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_library"
                app:tint="@drawable/nav_item_color" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_library"
                android:textSize="10sp"
                android:textColor="@drawable/nav_item_color" />
        </LinearLayout>

    </LinearLayout>

    <!-- Floating mini-player: shown when the user collapses a video via the
         down-chevron on the full player. Holds the SAME PlayerView instance
         (moved here, not duplicated) so ExoPlayer keeps playing without any
         interruption across the transition. Draggable — position is just
         updated via layout params in MainActivity's touch handler, no
         special drag library needed for a single free-floating box. -->
    <FrameLayout
        android:id="@+id/miniPlayerContainer"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:background="#000000"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="64dp">

        <ImageButton
            android:id="@+id/miniPlayerCloseBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:background="#80000000"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close mini player"
            app:tint="@color/text_primary" />
    </FrameLayout>

    <include
        layout="@layout/view_connection_error"
        android:id="@+id/connectionErrorInclude"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        layout="@layout/view_suggestions_panel"
        android:id="@+id/suggestionsPanelInclude"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Holds the custom view WebChromeClient.onShowCustomView hands us
         when a page (Crunchyroll) requests HTML5 video fullscreen —
         WebView itself has no native fullscreen concept, the site's own
         JS requestFullscreen() call expects the app to supply a view to
         render into, which is what this container is for. Sits above
         everything, including the connection-error overlay. -->
    <FrameLayout
        android:id="@+id/fullscreenVideoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
